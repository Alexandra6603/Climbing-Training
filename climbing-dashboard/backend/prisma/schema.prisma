generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Standard {
  id     String @id
  name   String
  unit   String

  values StandardAttemptValue[]
}

model StandardsAttempt {
  id        String   @id @default(cuid())
  date      DateTime
  status    String

  values StandardAttemptValue[]
}

model StandardAttemptValue {
  attemptId  String
  standardId String
  value      Float

  attempt  StandardsAttempt @relation(fields: [attemptId], references: [id])
  standard Standard         @relation(fields: [standardId], references: [id])

  @@id([attemptId, standardId])
}